<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme: pulling in AppCompat only for theming would
         cost more APK than the entire rest of the app. -->
    <style name="LudoTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/board_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:alertDialogTheme">@style/LudoDialog</item>
    </style>

    <!-- Dialogs on the setup screen's own panel colour and corners. Left to
         the platform they come out a flat grey that matches nothing else in
         the app. -->
    <style name="LudoDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:dialogCornerRadius">24dp</item>
        <item name="android:buttonBarButtonStyle">@style/LudoDialogButton</item>
    </style>

    <style name="LudoDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
